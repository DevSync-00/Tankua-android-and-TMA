{
  "name": "tankua-telegram-mini-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "next build && node scripts/package-sites.mjs",
    "telegram:previews": "node --env-file=.env.telegram.local scripts/upload-telegram-previews.mjs",
    "telegram:previews:qr": "node --env-file=.env.telegram.local scripts/upload-telegram-previews.mjs --qr-login",
    "telegram:previews:check": "node --env-file=.env.telegram.local scripts/upload-telegram-previews.mjs --dry-run",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "teleproto": "^1.229.0"
  }
}
